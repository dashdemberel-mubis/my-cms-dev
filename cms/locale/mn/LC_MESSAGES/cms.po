msgstr "токен"

#, python-format
msgid "You don't have %(type_pl)s available for this task."
msgstr "Энэ бодлогод ашиглах боломжтой %(type_pl)s танд алга."

#, python-format
msgid "You have an infinite number of %(type_pl)s for this task."
msgstr "Энэ бодлогод та хязгааргүй тооны %(type_pl)s эзэмшиж байна."

#, python-format
msgid "You start with no %(type_pl)s."
msgstr "Эхлэх үед танд %(type_pl)s байхгүй."

#, python-format
msgid "You start with one %(type_s)s."
msgid_plural "You start with %(gen_initial)d %(type_pl)s."
msgstr[0] "Эхлэх үед танд нэг %(type_s)s байна."
msgstr[1] "Эхлэх үед танд %(gen_initial)d %(type_pl)s байна."

#, python-format
msgid "Every minute "
msgid_plural "Every %(gen_interval)g minutes "
msgstr[0] "Минут тутамд "
msgstr[1] "%(gen_interval)g минут тутамд "

#, python-format
msgid "you get another %(type_s)s, "
msgid_plural "you get %(gen_number)d other %(type_pl)s, "
msgstr[0] "та дахин нэг %(type_s)s авна, "
msgstr[1] "та дахин %(gen_number)d %(type_pl)s авна, "

#, python-format
msgid "up to a maximum of one %(type_s)s."
msgid_plural "up to a maximum of %(gen_max)d %(type_pl)s."
msgstr[0] "гэхдээ дээд тал нь нэг %(type_s)s байна."
msgstr[1] "гэхдээ дээд тал нь %(gen_max)d %(type_pl)s байна."

#, python-format
msgid "you get another %(type_s)s."
msgid_plural "you get %(gen_number)d other %(type_pl)s."
msgstr[0] "та дахин нэг %(type_s)s авна."
msgstr[1] "та дахин %(gen_number)d %(type_pl)s авна."

#, python-format
msgid "You don't get other %(type_pl)s."
msgstr "Танд нэмж %(type_pl)s олгохгүй."

#, python-format
msgid "You can use a %(type_s)s every second "
msgid_plural "You can use a %(type_s)s every %(min_interval)g seconds "
msgstr[0] "Та секунд тутамд нэг %(type_s)s ашиглаж болно, "
msgstr[1] "Та %(min_interval)g секунд тутамд нэг %(type_s)s ашиглаж болно, "

#, python-format
msgid "and no more than one %(type_s)s in total."
msgid_plural "and no more than %(max_number)d %(type_pl)s in total."
msgstr[0] "гэхдээ нийтдээ нэгээс илүү %(type_s)s ашиглахгүй."
msgstr[1] "гэхдээ нийтдээ %(max_number)d-с илүү %(type_pl)s ашиглахгүй."

#, python-format
msgid "You can use a %(type_s)s every second."
msgid_plural "You can use a %(type_s)s every %(min_interval)g seconds."
msgstr[0] "Та секунд тутамд нэг %(type_s)s ашиглаж болно."
msgstr[1] "Та %(min_interval)g секунд тутамд нэг %(type_s)s ашиглаж болно."

#, python-format
msgid "You can use no more than one %(type_s)s in total."
msgid_plural "You can use no more than %(max_number)d %(type_pl)s in total."
msgstr[0] "Та нийтдээ нэгээс илүү %(type_s)s ашиглах боломжгүй."
msgstr[1] "Та нийтдээ %(max_number)d-с илүү %(type_pl)s ашиглах боломжгүй."

msgid "You have no limitations on how you use them."
msgstr "Тэдгээрийг ашиглахад ямар нэг хязгаарлалт байхгүй."

