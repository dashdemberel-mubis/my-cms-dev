#, python-format
msgid "Subtask %(index)s"
msgstr "Дэд бодлого %(index)s"

msgid "Compilation succeeded"
msgstr "Амжилттай хөрвүүллээ"

msgid "Your submission successfully compiled to an executable."
msgstr "Таны илгээсэн код амжилттай хөрвүүлэгдэж, ажиллах файл үүслээ."

msgid "Compilation failed"
msgstr "Хөрвүүлэлт амжилтгүй"

msgid "Your submission did not compile correctly."
msgstr "Таны илгээсэн код зөв хөрвүүлэгдсэнгүй."

msgid "Compilation timed out"
msgstr "Хөрвүүлэх хугацаа хэтэрсэн"

msgid "Your submission exceeded the time limit while compiling. This might be caused by an excessive use of C++ templates, for example."
msgstr "Таны илгээсэн кодыг хөрвүүлэхэд хугацааны хязгаар хэтэрлээ. Жишээ нь C++-ийн template-ийг хэт их ашигласнаас ийм зүйл гарч болно."

#, python-format
msgid "Compilation killed with signal %s (could be triggered by violating memory limits)"
msgstr "Хөрвүүлэлт %s дугаар сигналаар зогссон (санах ойн хязгаар зөрчсөнөөс байж болно)"

msgid "Your submission was killed with the specified signal. Among other things, this might be caused by exceeding the memory limit for the compilation, and in turn by an excessive use of C++ templates, for example."
msgstr "Таны илгээлт заасан сигналаар зогслоо. Үүний шалтгаан нь хөрвүүлэх үеийн санах ойн хязгаар хэтэрсэн байх зэрэг байж болно, тухайлбал C++-ийн template-ийг хэт их ашигласнаас үүдэж болно."

msgid "Output is correct"
msgstr "Гаралт зөв"

msgid "Your submission ran and gave the correct answer"
msgstr "Таны програм ажиллаж, зөв хариу гаргалаа"

msgid "Output is partially correct"
msgstr "Гаралт хэсэгчлэн зөв"

msgid "Your submission ran and gave the partially correct answer"
msgstr "Таны програм ажиллаж, хэсэгчлэн зөв хариу гаргалаа"

msgid "Output isn't correct"
msgstr "Гаралт буруу"

msgid "Your submission ran, but gave the wrong answer"
msgstr "Таны програм ажилласан боловч буруу хариу гаргалаа"

#, python-format
msgid "Evaluation didn't produce file %s"
msgstr "Үнэлгээний явцад %s файл үүссэнгүй"

msgid "Your submission ran, but did not write on the correct output file"
msgstr "Таны програм ажилласан боловч зөв гаралтын файлд бичсэнгүй"

msgid "Execution timed out"
msgstr "Гүйцэтгэх хугацаа хэтэрсэн"

msgid "Your submission used too much CPU time."
msgstr "Таны програм процессорын хугацааг хэт их ашигласан."

msgid "Execution timed out (wall clock limit exceeded)"
msgstr "Гүйцэтгэх хугацаа хэтэрсэн (бодит хугацааны хязгаар хэтэрсэн)"

msgid "Your submission used too much total time. This might be triggered by undefined code, or buffer overflow, for example. Note that in this case the CPU time visible in the submission details might be much smaller than the time limit."
msgstr "Таны програмын нийт ажилласан хугацаа хэт урт байна. Жишээ нь тодорхойгүй үйлдэлтэй код (undefined behavior) эсвэл буферийн халилтаас ийм зүйл гарч болно. Энэ тохиолдолд илгээлтийн дэлгэрэнгүйд харагдах процессорын хугацаа хугацааны хязгаараас хамаагүй бага байж болохыг анхаарна уу."

msgid "Memory limit exceeded"
msgstr "Санах ойн хязгаар хэтэрсэн"

msgid "Your submission used too much memory."
msgstr "Таны програм санах ойг хэт их ашигласан."

msgid "Execution killed by signal"
msgstr "Програм сигналаар зогссон"

msgid "The evaluation was killed by a signal."
msgstr "Үнэлгээний явцад програм сигналаар зогссон."

msgid "Execution failed because the return code was nonzero"
msgstr "Буцаах код тэг биш тул гүйцэтгэл амжилтгүй"

msgid "Your submission failed because it exited with a return code different from 0."
msgstr "Таны програм 0-ээс ялгаатай кодтой дууссан тул амжилтгүй боллоо."

msgid "Execution completed successfully"
msgstr "Гүйцэтгэл амжилттай дууссан"

msgid "No compilation needed"
msgstr "Хөрвүүлэх шаардлагагүй"

msgid "File not submitted"
msgstr "Файл илгээгээгүй"

msgid "Question too long!"
msgstr "Асуулт хэт урт байна!"

#, python-format
msgid "Subject must be at most %(max_subject_length)d characters, content at most %(max_text_length)d."
msgstr "Гарчиг %(max_subject_length)d, агуулга %(max_text_length)d тэмдэгтээс хэтрэхгүй байх ёстой."

