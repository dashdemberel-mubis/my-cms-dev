msgid "Submissions too frequent!"
msgstr "Илгээлт хэт ойрхон байна!"

#, python-format
msgid "Among all tasks, you can submit again after %d seconds from last submission."
msgstr "Сүүлийн илгээлтээс хойш %d секундын дараа та (аль ч бодлогод) дахин илгээж болно."

#, python-format
msgid "For this task, you can submit again after %d seconds from last submission."
msgstr "Сүүлийн илгээлтээс хойш %d секундын дараа та энэ бодлогод дахин илгээж болно."

msgid "Submission too big!"
msgstr "Илгээлт хэт том байна!"

#, python-format
msgid "Each source file must be at most %d bytes long."
msgstr "Эх кодын файл бүр %d байтаас хэтрэхгүй байх ёстой."

#, python-format
msgid "The submission should contain at most %d files."
msgstr "Нэг илгээлтэд %d-с илүү файл байж болохгүй."

msgid "Invalid archive format!"
msgstr "Архивын формат буруу!"

msgid "The submitted archive could not be opened."
msgstr "Илгээсэн архивыг нээж чадсангүй."

msgid "Invalid submission format!"
msgstr "Илгээлтийн формат буруу!"

msgid "Please select the correct files."
msgstr "Зөв файлуудаа сонгоно уу."

msgid "Submission storage failed!"
msgstr "Илгээлтийг хадгалж чадсангүй!"

msgid "Please try again."
msgstr "Дахин оролдоно уу."

msgid "Too many tests!"
msgstr "Хэт олон тест!"

#, python-format
msgid "You have reached the maximum limit of at most %d tests among all tasks."
msgstr "Та бүх бодлогод нийт ажиллуулж болох тестийн дээд хязгаарт (%d тест) хүрсэн байна."

#, python-format
msgid "You have reached the maximum limit of at most %d tests on this task."
msgstr "Та энэ бодлогод ажиллуулж болох тестийн дээд хязгаарт (%d тест) хүрсэн байна."

msgid "Tests too frequent!"
msgstr "Тест хэт ойрхон байна!"

#, python-format
msgid "Among all tasks, you can test again after %d seconds from last test."
msgstr "Сүүлийн тестээс хойш %d секундын дараа та (аль ч бодлогод) дахин тест ажиллуулж болно."

#, python-format
msgid "For this task, you can test again after %d seconds from last test."
msgstr "Сүүлийн тестээс хойш %d секундын дараа та энэ бодлогод дахин тест ажиллуулж болно."

msgid "Invalid test format!"
msgstr "Тестийн формат буруу!"

msgid "Test too big!"
msgstr "Тест хэт том байна!"

msgid "Input too big!"
msgstr "Оролт хэт том байна!"

#, python-format
